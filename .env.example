# ── Nuvemshop ─────────────────────────────────────────────────────────────────
# Token de API da loja (Configurações → Aplicativos → Criar aplicativo)
NS_TOKEN=SEU_TOKEN_AQUI

# ID numérico da sua loja (aparece na URL do painel Nuvemshop)
NS_STORE=SEU_STORE_ID_AQUI

# ── Notion ────────────────────────────────────────────────────────────────────
# Token de integração para buscar o calendário de conteúdo
# Como criar:
#   1. Acesse https://www.notion.so/my-integrations
#   2. Clique em "Nova integração" → dê um nome (ex: "Backbe Dashboard")
#   3. Selecione seu workspace e clique em "Enviar"
#   4. Copie o "Token secreto interno" (começa com "secret_")
#   5. Abra a página "Calendário - meses" no Notion
#   6. Clique nos "..." no topo → "Adicionar conexões" → selecione sua integração
# No Streamlit Cloud: adicione em Settings → Secrets como NOTION_TOKEN = "secret_..."
NOTION_TOKEN=secret_SEU_TOKEN_NOTION_AQUI

# ── TikTok Shop ───────────────────────────────────────────────────────────────
# Integração para subir produtos novos e atualizar estoque pronta entrega.
# Como obter:
#   1. Acesse o TikTok Shop Partner Center: https://partner.tiktokshop.com
#   2. Crie um app em "Manage apps" → copie o App key e App secret
#   3. Autorize sua loja no app (fluxo OAuth) → você recebe o access_token
#   4. Chame /authorization/202309/shops (ou veja get_authorized_shops no app)
#      para descobrir o shop_cipher da sua loja
# No Streamlit Cloud: adicione cada um em Settings → Secrets.
TIKTOK_APP_KEY=SEU_APP_KEY_AQUI
TIKTOK_APP_SECRET=SEU_APP_SECRET_AQUI
TIKTOK_ACCESS_TOKEN=SEU_ACCESS_TOKEN_AQUI
TIKTOK_SHOP_CIPHER=SEU_SHOP_CIPHER_AQUI

# Opcionais:
# TIKTOK_SHOP_ID=...           # id numérico da loja (informativo)
# TIKTOK_WAREHOUSE_ID=...      # se vazio, usa o primeiro armazém de vendas
# TIKTOK_CATEGORY_ID=...       # categoria padrão p/ criar produtos novos
# TIKTOK_BASE_URL=https://open-api.tiktokglobalshop.com
# TIKTOK_API_VERSION=202309
