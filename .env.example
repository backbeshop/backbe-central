# ── Nuvemshop ─────────────────────────────────────────────────────────────────
# Token de API da loja (Configurações → Aplicativos → Criar aplicativo)
NS_TOKEN=SEU_TOKEN_AQUI

# ID numérico da sua loja (aparece na URL do painel Nuvemshop)
NS_STORE=SEU_STORE_ID_AQUI

# ── Notion ────────────────────────────────────────────────────────────────────
# Token de integração para buscar o calendário de conteúdo
# Como criar:
#   1. Acesse https://www.notion.so/my-integrations
#   2. Clique em "Nova integração" → dê um nome (ex: "Backbe Dashboard")
#   3. Selecione seu workspace e clique em "Enviar"
#   4. Copie o "Token secreto interno" (começa com "secret_")
#   5. Abra a página "Calendário - meses" no Notion
#   6. Clique nos "..." no topo → "Adicionar conexões" → selecione sua integração
# No Streamlit Cloud: adicione em Settings → Secrets como NOTION_TOKEN = "secret_..."
NOTION_TOKEN=secret_SEU_TOKEN_NOTION_AQUI
